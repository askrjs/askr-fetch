{
  "name": "@askrjs/fetch",
  "version": "0.0.1",
  "description": "Function-first typed HTTP contracts and clients for Askr.",
  "keywords": [
    "askr",
    "fetch",
    "http",
    "typescript"
  ],
  "homepage": "https://github.com/askrjs/askr-fetch#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr-fetch/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askrjs/askr-fetch.git"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "fmt": "vp fmt .",
    "lint": "vp lint src tests vite.config.ts && npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vp test run",
    "test:installed": "node tests/installed-smoke.js",
    "test:publint": "publint",
    "pack:check": "npm pack --ignore-scripts --dry-run --json",
    "check": "npm run lint && npm test && npm run build && npm run test:installed && npm run test:publint && npm run pack:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@12.0.1"
}
