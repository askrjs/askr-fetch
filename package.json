{
  "name": "@askrjs/fetch",
  "version": "0.0.1",
  "description": "Function-first typed HTTP contracts and clients for Askr.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./middleware": { "types": "./dist/middleware.d.ts", "import": "./dist/middleware.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "README.md", "LICENSE"],
  "scripts": {
    "build": "vp pack",
    "lint": "vp lint src tests vite.config.ts && npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vp test run",
    "test:publint": "publint",
    "pack:check": "npm pack --ignore-scripts --dry-run --json",
    "check": "npm run lint && npm test && npm run build && npm run test:publint && npm run pack:check"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.4",
    "vitest": "^4.1.10"
  },
  "engines": { "node": ">=20.19.0" },
  "packageManager": "npm@12.0.1"
}
